
///////////////////////////////////////////////////////////////////////////////
//// Assumptions that the PD makes about the environment.
//// These become assumptions in the proof, and unsubstantiated assumptions can
//// lead to unsoundness. Tread lightly.

define f_user_rely_init(heap,gv)
(
    // Assumed to hold when entering uep_init()
    acc(gv.unanswered_pings)
)

define f_user_rely_receive(heap,gv,pp,pf,ns) (
    // Assumed to hold whenever this PD receives on its endpoint
    true
)

define f_user_rely_microkit_ppcall(heap,gv,ch,msginfo,retval)
(
    // Assumed to hold whenever a ppcall returns in this PD
    // WARN: assumed to hold together with `f_user_guarantee_microkit_ppcall`.
    // It is best not to put any `acc(-)` or other impure predicates here,
    // since access rights exceeding 1 will cause unsoundness.
    true
)

///////////////////////////////////////////////////////////////////////////////
//// Guarantees provided by the PD on externally visible events.
//// These become proof obligations that the user/verifier must show to hold
//// whenever the corresponding event takes place.

define f_user_guarantee_microkit_notify(heap,gv,ch)
(
    // Checked to hold whenever this PD makes a microkit_notify(ch) call
    acc(gv.unanswered_pings) &&
    gv.unanswered_pings == 0
)

define f_user_guarantee_microkit_ppcall(heap,gv,ch,msginfo) (
    // Checked to hold whenever this PD makes a microkit_ppcall(ch, msg) call
    true
)

define f_user_guarantee_reply(heap,gv) (
    // Checked to hold whenever this PD transmits the result of a
    // `fault` or `protected` call to another PD
    true
)

///////////////////////////////////////////////////////////////////////////////
//// Loop invariants for Microkit's internal loops
//// The preservation of these invariants becomes a proof obligation that the
//// user/verifier must show.

define f_user_handler_loop_entry(heap,gv)
(
    gv.microkit_have_signal == 0 &&
    acc(gv.unanswered_pings) &&
    gv.unanswered_pings == 1
)

define f_user_handler_loop_invariant(heap,gv,have_reply)
(
    have_reply == 0 &&
    gv.microkit_have_signal == 0 &&
    acc(gv.unanswered_pings) &&
    gv.unanswered_pings == 1
)

define f_user_notified_loop_invariant(heap,gv,channel_index)
(
    acc(gv.unanswered_pings) &&
    gv.unanswered_pings == 1
)
