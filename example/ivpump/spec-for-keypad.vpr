///////////////////////////////////////////////////////////////////////////////
// user: event mk_NBSendRecv()                                               //
///////////////////////////////////////////////////////////////////////////////
// args: panseL4_CPtr signal_cap,
//       panseL4_MessageInfo_t signal_msg
// retval: panseL4_Response (response_tag, pp, pf, ns)

define user_guard_NBSendRecv(signal_cap, signal_msg, state)
(
    // Checked to hold whenever this PD triggers an `NBSendRecv` event. This
    // happens when a handler loop iteration starts, and the previous iteration
    // used a `microkit_deferred_notify` or `microkit_deferred_irq_ack` call.
    false // keypad does not use deferred calls
)
define f_user_guard_NBSendRecv(heap, gv, signal_cap, signal_msg, state)
  (user_guard_NBSendRecv(signal_cap, signal_msg, state))


define user_transition_NBSendRecv(signal_cap, signal_msg, response_tag, pp, pf, ns, state)
(
    // Describes the possible ghost state transitions permitted after this PD
    // triggers an `NBSendRecv` event.
    false
)
define f_user_transition_NBSendRecv(heap, gv, signal_cap, signal_msg, response_tag, pp, pf, ns, state)
  (user_transition_NBSendRecv(signal_cap, signal_msg, response_tag, pp, pf, ns, state))

define user_rely_NBSendRecv(signal_cap, signal_msg, response_tag, pp, pf, ns, state) (
    // Assumed to hold whenever this PD receives a response on its endpoint.
    false
)
define f_user_rely_NBSendRecv(heap, gv, signal_cap, signal_msg, response_tag, pp, pf, ns, state)
  (user_rely_NBSendRecv(signal_cap, signal_msg, response_tag, pp, pf, ns, state))



