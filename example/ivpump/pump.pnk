#define CONTROL_ADDR 33554432
#define COMMAND_ADDR 33562624

/@ extern function mk_notified_preconditions(ch: Int): Bool @/
/@ extern function mk_notified_postconditions(ch: Int): Bool @/
/@ extern function apply_is_userland(x: Bool): Bool @/

/@ extern field has_control: Bool @/
/@ extern field unhandled_cmds: Seq[Int] @/
/@ extern field handled_cmds: Seq[Int] @/
/@ extern function Seq(): Seq[Int] @/
/@ extern function Seq1(ch: Int): Seq[Int] @/

fun uep_init() {
    /@ requires user_acc_ghost_state(userGhost()) @/
    /@ requires user_rely_init(userGhost()) @/
    /@ ensures false @/ // never terminates
    @microkit_report_debug(0, 0, 0, 1);
    microkit_notify(42);
    var 1 control = 0;
    while (true) {
        /@ invariant
           (
                control != 1 &&
                user_acc_ghost_state(userGhost()) &&
                !userGhost().has_control &&
                userGhost().unhandled_cmds == Seq()
           )
        @/
        while (control != 1) {
            /@ invariant 
               user_acc_ghost_state(userGhost()) &&
               userGhost().unhandled_cmds == Seq() &&
               (
                   (control == 1 && userGhost().has_control) ||
                   (control != 1 && !userGhost().has_control)
               )
            @/
            !ldw control, CONTROL_ADDR;
        }
        var 1 command = 0;
        !ldw command, COMMAND_ADDR;
        !stw CONTROL_ADDR, 0;
        control = 0; // bug found during verif.: we were missing this line
        // simulate a keypad notify so we don't get bored
        var 1 delay = 10000000;
        while (delay > 0) {
            /@ invariant 0 <= delay && delay <= 10000000 @/
            delay = delay - 1;
        }
        microkit_notify(42);
    }
    return 0;
}

fun uep_notified(microkit_channel ch) {
    /@ requires mk_notified_preconditions(ch) @/
    /@ ensures mk_notified_postconditions(ch)@/
    /@ assert apply_is_userland(true) @/
    return 0;
}

fun microkit_fault_reply_option uep_fault(microkit_child child, microkit_msginfo msginfo) {
    /@ ensures retval.0 == 0 @/
    @microkit_report_debug(0, 0, 0, 4);
    return microkit_fault_reply_nothing;
}

fun uep_protected(microkit_channel ch, microkit_msginfo msginfo) {
    /@ requires acc(heap[0]) @/
    /@ requires acc(heap[1]) @/
    /@ requires acc(heap[2]) @/
    /@ requires acc(heap[3]) @/
    /@ ensures IsAbsMsgInfo(retval) @/
    @microkit_report_debug(0, 0, 0, 3);
    var 1 res = panseL4_MessageInfo_new(0,0,0,0);
    return res;
}
