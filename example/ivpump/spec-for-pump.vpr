///////////////////////////////////////////////////////////////////////////////
// user: event shared_load64()                                               //
///////////////////////////////////////////////////////////////////////////////
// args: 1 address
// retval: 1

define user_guard_shared_load64(address, state)
(
    (
        address == 33554432 && // CONTROL_ADDR
        !state.has_control
    )
    ||
    (
        address == 33562624 && // COMMAND_ADDR
        state.has_control &&
        state.unhandled_cmds == Seq()
    )
)
define f_user_guard_shared_load64(heap, gv, address, state)
  (user_guard_shared_load64(address, state))


define user_transition_shared_load64(address, retval, state)
(
    (
        address == 33554432 && // CONTROL_ADDR
        state.has_control == (retval == 1) &&
        state.unhandled_cmds == old(state.unhandled_cmds) &&
        state.handled_cmds == old(state.handled_cmds)
    )
    ||
    (
        address == 33562624 && // COMMAND_ADDR
        state.has_control == old(state.has_control) &&
        state.unhandled_cmds == Seq(retval) &&
        state.handled_cmds == old(state.handled_cmds)
    )
    // the command area contains which key press we received
)
define f_user_transition_shared_load64(heap, gv, address, retval, state)
  (user_transition_shared_load64(address, retval, state))


define user_rely_shared_load64(address, retval, state)
(
    true
)
define f_user_rely_shared_load64(heap, gv, address, retval, state)
  (user_rely_shared_load64(address, retval, state))



