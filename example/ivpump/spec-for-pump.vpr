define f_Seq(heap,gv) (
    Seq()
)

define f_Seq1(heap,gv,ch) (
    Seq(ch)
)



///////////////////////////////////////////////////////////////////////////////
// user: the PD ghost state                                                  //
///////////////////////////////////////////////////////////////////////////////

field has_control: Bool
field unhandled_cmds: Seq[Int]
field handled_cmds: Seq[Int]

define user_acc_ghost_state(state)
(
    acc(state.has_control) &&
    acc(state.unhandled_cmds) &&
    acc(state.handled_cmds)
)
define f_user_acc_ghost_state(heap, gv, state)
  (user_acc_ghost_state(state))



///////////////////////////////////////////////////////////////////////////////
// user specs for the PD's local state machine                               //
///////////////////////////////////////////////////////////////////////////////
// Each Microkit event has a corresponding `user_guard` and `user_transition`
// predicate. The Microkit events with return values also have a `user_rely`.
// 
// `user_guard`:
// A guard states that the PD will not emit the corresponding Microkit event,
// except when the PD's current ghost state satisfies the guard predicate.
// Locally these become proof obligations that the user/verifier must show to
// hold whenever the program executes a call that causes the corresponding
// event.
//
// `user_transition`:
// The transition predicate determines whether a PD may transition from its
// state before emitting a Microkit event (the `old(state)`) to a given state
// after emitting the Microkit event. The transition that actually takes place 
// is chosen nondeterministically from all possible new states that satisfy the
// transition relation. Note that the transition relation may constrain an
// environment-controlled return value. Such a constraint does not remove the
// return value as a possibility from the global event model. It only means
// that a run cannot transition to a new state that constrains the return value
// to something other than the environment-dictated value.
// Note that the variable `state` in the transition relation always references
// the ghost state _after_ the call. Use `old(state.field)` to describe the
// pre-transition ghost state.
//
// `user_rely`:
// The reliance predicate states an environmental assumption used in the local
// proof, by expressing a relation between a pre-transition ghost state and
// the possible return values of a Microkit event. These assumptions have to be
// proven as part of a global proof about the state machines. Note that in a
// reliance predicate, one must use `old(state.field)`` to refer to the ghost
// state before the transition, and one is not allowed to mention `state.field`
// by itself. This syntactic discipline is not statically checked, the proof
// engineer must maintaine it!



///////////////////////////////////////////////////////////////////////////////
// user: event microkit_notify()                                             //
///////////////////////////////////////////////////////////////////////////////
// args: microkit_channel ch

define user_guard_microkit_notify(ch, state)
(
    true
    // Pump may notify anybody at any time. This should break any global proof
    // attempt trying to show that `pump.handled_cmds` is at all times a subset
    // of `keypad.issued_cmds`. The right guard would rule out notifications
    // while `pump.has_control`
)
define f_user_guard_microkit_notify(heap, gv, ch, state)
  (user_guard_microkit_notify(ch, state))


define user_transition_microkit_notify(ch, state)
(
    state.has_control == old(state.has_control) &&
    state.unhandled_cmds == old(state.unhandled_cmds) &&
    state.handled_cmds == old(state.handled_cmds)
    // sending a notification does not change the state
)
define f_user_transition_microkit_notify(heap, gv, ch, state)
  (user_transition_microkit_notify(ch, state))



