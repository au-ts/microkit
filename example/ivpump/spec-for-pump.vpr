///////////////////////////////////////////////////////////////////////////////
// retval: panseL4_Response (response_tag, pp, pf, ns)

define user_guard_Recv(state)
(
    false // pump never leaves the init loop, doesn't receive
)
define f_user_guard_Recv(heap, gv, state)
  (user_guard_Recv(state))


define user_transition_Recv(response_tag, pp, pf, ns, state)
(
    false // pump never leaves the init loop, doesn't receive
)
define f_user_transition_Recv(heap, gv, response_tag, pp, pf, ns, state)
  (user_transition_Recv(response_tag, pp, pf, ns, state))


define user_rely_Recv(response_tag, pp, pf, ns, state) (
    true
)
define f_user_rely_Recv(heap, gv, response_tag, pp, pf, ns, state)
  (user_rely_Recv(response_tag, pp, pf, ns, state))



