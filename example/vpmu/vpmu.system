<system>
    <protection_domain name="parent" priority="254">
        <program_image path="parent.elf" />
        <vpmu virq_id="10"/>

        <protection_domain name="child" priority="1" id="0" setvar_id="child_id">
            <program_image path="child.elf" />
        </protection_domain>
    </protection_domain>
    <channel>
        <end pd="parent" id="20" setvar_id="child_channel_id"/>
        <end pd="child" id="20" setvar_id="parent_channel_id"/>
    </channel>
</system>