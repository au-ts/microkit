<system>
    <memory_region name="pci_config" size="0x1000" page_size="0x1000" phys_addr="0x3002_0000" />
    <memory_region name="edu_mmio_window" size="0x10_0000" page_size="0x1000" phys_addr="0x4000_0000"/>
    <memory_region name="imsic" size="0x1000" page_size="0x1000" phys_addr="0x2800_0000"/>
    <memory_region name="dma_buffer" size="0x1000" page_size="0x1000"/>

    <io_address_space name="QEMU EDU">
        <device peripheral_id="0x20" iommu="0x0301_0000"/>
        <iomap mr="dma_buffer" iovaddr="0x10_0000"/>
        <iomap mr="imsic" iovaddr="0x30_0000"/>
    </io_address_space>

    <protection_domain name="riscv64_iommu_dma_test" priority="100">
        <program_image path="riscv64_iommu_dma_test.elf"/>
        <irq irq="63" id="0"/>
        <map mr="pci_config" vaddr="0x1000_0000" perms="rw" cached="false" setvar_vaddr="pci_config_vaddr"/>
        <map mr="edu_mmio_window" vaddr="0x2000_0000" perms="rw" cached="false" setvar_vaddr="edu_mmio_window_vaddr" />
        <map mr="dma_buffer" vaddr="0x3000_0000" perms="rw" cached="true" setvar_vaddr="dma_buffer_vaddr" />
    </protection_domain>
</system>
